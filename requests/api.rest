# Kasbon API — REST Client (ekstensi Huachao Mao)
#
# CARA PAKAI:
# 1. Copy requests/.env.rest.example menjadi requests/.env, isi nilainya.
# 2. Jalankan `npm run dev`, pastikan BASE_URL di requests/.env cocok.
# 3. Kirim request berurutan dari atas (ada yang merantai via request variable).
#
# COOKIE (auth app ini berbasis cookie Supabase SSR, BUKAN Bearer):
# - Browser yang sedang login -> DevTools -> Application -> Cookies ->
#   copy SEMUA cookie bernama sb-*-auth-token, gabung dengan "; ", paste ke
#   COOKIE_A / COOKIE_B di requests/.env.
# - Cookie kedaluwarsa kira-kira per jam. Jika tiba-tiba semua 401,
#   login ulang di browser lalu copy cookie yang baru.
#
# REQUEST VARIABLE: {{nama.response.body.$.path}} hanya terisi SETELAH
# request bernama itu dikirim. Jangan lompat urutan di bagian berantai.

@baseUrl = {{$dotenv BASE_URL}}

### 1a. Tanpa cookie: GET harus 401
# Harapan: 401 + {"success":false,"error":"Sesi kamu sudah berakhir. Silakan login kembali ya."}
# @name getNoAuth
GET {{baseUrl}}/api/debts

### 1b. Tanpa cookie: POST valid tetap 401 (auth dicek SEBELUM validasi)
# Harapan: 401 + pesan BI yang sama
# @name postNoAuth
POST {{baseUrl}}/api/debts HTTP/1.1
Content-Type: application/json

{
  "type": "owed_to_me",
  "counterpart_name": "Budi",
  "amount": 150000
}

### 1c. Tanpa cookie: PATCH harus 401
# Harapan: 401 + pesan BI yang sama
# @name patchNoAuth
PATCH {{baseUrl}}/api/debts/11111111-1111-1111-1111-111111111111 HTTP/1.1
Content-Type: application/json

{
  "is_settled": true
}

### 1d. Tanpa cookie: DELETE harus 401
# Harapan: 401 + pesan BI yang sama
# @name deleteNoAuth
DELETE {{baseUrl}}/api/debts/11111111-1111-1111-1111-111111111111 HTTP/1.1

### 2a. GET tanpa filter (cookie A)
# Harapan: 200 + {success, data[], summary{owed_to_me,i_owe,net}}.
# Catat summary-nya, bandingkan dengan request 2b-2h: HARUS SAMA (independen filter).
# @name getAll
GET {{baseUrl}}/api/debts HTTP/1.1
Cookie: {{$dotenv COOKIE_A}}

### 2b. GET status=unsettled
# Harapan: 200, semua data.settled_at null, summary SAMA dengan 2a
# @name getUnsettled
GET {{baseUrl}}/api/debts?status=unsettled HTTP/1.1
Cookie: {{$dotenv COOKIE_A}}

### 2c. GET status=settled
# Harapan: 200, semua data.settled_at terisi, summary SAMA dengan 2a
# @name getSettled
GET {{baseUrl}}/api/debts?status=settled HTTP/1.1
Cookie: {{$dotenv COOKIE_A}}

### 2d. GET type=owed_to_me
# Harapan: 200, semua data.type owed_to_me, summary SAMA dengan 2a
# @name getOwedToMe
GET {{baseUrl}}/api/debts?type=owed_to_me HTTP/1.1
Cookie: {{$dotenv COOKIE_A}}

### 2e. GET type=i_owe
# Harapan: 200, semua data.type i_owe, summary SAMA dengan 2a
# @name getIOwe
GET {{baseUrl}}/api/debts?type=i_owe HTTP/1.1
Cookie: {{$dotenv COOKIE_A}}

### 2f. GET kombinasi filter + search
# Harapan: 200, irisan ketiga filter, summary SAMA dengan 2a
# @name getCombo
GET {{baseUrl}}/api/debts?status=unsettled&type=owed_to_me&search=Budi HTTP/1.1
Cookie: {{$dotenv COOKIE_A}}

### 2g. GET search=Budi
# Harapan: 200, hanya counterpart_name mengandung Budi (case-insensitive)
# @name getSearchBudi
GET {{baseUrl}}/api/debts?search=Budi HTTP/1.1
Cookie: {{$dotenv COOKIE_A}}

### 2h. GET search karakter % (ditulis %25) — harus literal, bukan wildcard
# Harapan: 200, TIDAK error, % tidak melebarkan hasil
# @name getSearchPercent
GET {{baseUrl}}/api/debts?search=100%25 HTTP/1.1
Cookie: {{$dotenv COOKIE_A}}

### 2i. GET search karakter _ — harus literal, bukan wildcard satu-karakter
# Harapan: 200, TIDAK error, _ tidak melebarkan hasil
# @name getSearchUnderscore
GET {{baseUrl}}/api/debts?search=a_b HTTP/1.1
Cookie: {{$dotenv COOKIE_A}}

### 2j. GET status=ngawur harus 400
# Harapan: 400 + "Filter status-nya nggak dikenal nih."
