### 7a. [Supabase langsung] login user B, simpan access_token
# Harapan: 200 + {access_token,...}. Token dipakai 7b.
# @name loginB
POST {{$dotenv SUPABASE_URL}}/auth/v1/token?grant_type=password HTTP/1.1
apikey: {{$dotenv SUPABASE_PUBLISHABLE_KEY}}
Content-Type: application/json

{
  "email": "{{$dotenv TEST_EMAIL_B}}",
  "password": "{{$dotenv TEST_PASSWORD_B}}"
}

### 7b. [Supabase langsung] REST dengan token B — tidak ada row milik A
# Harapan: 200, TIDAK ADA counterpart_name "TES-LINTAS-USER" (atau [] jika
# B belum punya data). Ini bukti RLS di level database, bukan hanya API.
# @name restWithB
GET {{$dotenv SUPABASE_URL}}/rest/v1/debts?select=id,counterpart_name,amount HTTP/1.1
apikey: {{$dotenv SUPABASE_PUBLISHABLE_KEY}}
Authorization: Bearer {{loginB.response.body.$.access_token}}

### 7c. [Supabase langsung] apikey saja tanpa Authorization
# Harapan: DITOLAK atau [] — catat status asli yang muncul. Yang penting:
# tanpa JWT tidak ada data yang keluar (REVOKE anon + RLS).
# @name restAnon
GET {{$dotenv SUPABASE_URL}}/rest/v1/debts?select=id,counterpart_name HTTP/1.1
apikey: {{$dotenv SUPABASE_PUBLISHABLE_KEY}}
