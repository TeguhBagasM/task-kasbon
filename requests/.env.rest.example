# Template rahasia untuk requests/api.rest — TANPA nilai asli.
# Cara pakai: copy file ini menjadi requests/.env (tidak ter-commit),
# lalu isi nilainya. requests/.env dibaca otomatis oleh {{$dotenv}}.
BASE_URL=http://localhost:3000
# Cookie: buka DevTools browser yang sedang login -> Application -> Cookies
# -> gabungkan semua cookie sb-*-auth-token dengan "; " di antaranya.
COOKIE_A=paste-cookie-lengkap-user-A-di-sini
COOKIE_B=paste-cookie-lengkap-user-B-di-sini
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_isi-lengkap-di-sini
TEST_EMAIL_A=email-user-a-untuk-login-langsung@example.com
TEST_PASSWORD_A=password-user-a-minimal-6-karakter
TEST_EMAIL_B=email-user-b-untuk-login-langsung@example.com
TEST_PASSWORD_B=password-user-b-minimal-6-karakter
