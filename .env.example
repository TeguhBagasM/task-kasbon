# Supabase — isi dari dashboard Supabase (Project Settings > API)
# Cek di dashboard apakah bernama "anon key" atau "publishable key".
# Jika publishable key, tetap pakai nama var ini (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
# agar jelas. Jangan pernah commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-atau-publishable-key
