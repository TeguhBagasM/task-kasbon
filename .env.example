# Supabase — isi dari dashboard Supabase (Project Settings > API).
# Dashboard baru melabeli key sebagai "publishable key" (format sb_publishable_...).
# Salin nilai ASLI ke .env.local (file ini hanya template, jangan isi kredensial).
# Jangan pernah commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
